# Dónde vive la base SQLite. En Docker apuntá a un volumen persistente.
SQLITE_PATH=./data/finanzas.db

# Zona horaria: define qué día es "hoy" y cuándo abre la ventana del 28 al 15.
TZ=America/Argentina/Buenos_Aires

# En producción tiene que ser production: activa la cookie de sesión Secure,
# que solo viaja por HTTPS.
NODE_ENV=production

PORT=3100

# La cookie de sesión solo viaja por HTTPS. En producción es lo correcto, pero
# si entrás por http://192.168.x.x el navegador la descarta y el login rebota
# sin decir por qué. Ponelo en false mientras no tengas certificado.
COOKIE_SECURE=false

# Dónde se guardan las fotos de los tickets y el diccionario del OCR.
RECEIPTS_PATH=./data/receipts
TESSERACT_CACHE=./data/tesseract
