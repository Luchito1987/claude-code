# Dónde vive la base SQLite. En Docker apuntá a un volumen persistente.
SQLITE_PATH=./data/finanzas.db

# Zona horaria: define qué día es "hoy" y cuándo abre la ventana del 28 al 15.
TZ=America/Argentina/Buenos_Aires

# En producción tiene que ser production: activa la cookie de sesión Secure,
# que solo viaja por HTTPS.
NODE_ENV=production

PORT=3100
